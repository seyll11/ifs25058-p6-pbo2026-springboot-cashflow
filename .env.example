APP_PORT=8080

DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=pbo2026_cashflow
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Opsional (mis. Render): URL JDBC lengkap, menggantikan DB_HOST/DB_PORT/DB_DATABASE
# DB_URL=jdbc:postgresql://HOST:5432/DBNAME

ROOT_USERNAME=admin
ROOT_PASSWORD=admin

UPLOAD_DIR=uploads

# AI: Google AI Studio (Gemini) lewat endpoint OpenAI-compatible
# Buat API key di https://aistudio.google.com/apikey
OPENAI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_KEY=isi_api_key_dari_google_ai_studio
OPENAI_MODEL=gemini-3.8-flash
